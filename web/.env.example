# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > Your apps > Web app.
# These are public client identifiers, not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# reCAPTCHA Enterprise site key for production/hosting.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local development set this to "true" and register the debug token
# printed in the browser console under App Check > Manage debug tokens.
VITE_APPCHECK_DEBUG=true
