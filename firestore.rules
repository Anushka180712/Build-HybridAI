rules_version = '2';

// Chaukas security rules.
// - Each person's synced history is private to them, with a fixed shape.
// - A Family Circle is readable only by its members (and people invited to it).
//   Anyone signed in may join with the 6-character code by adding *only
//   themselves*, and any member may leave by removing *only themselves*.
//   The app keeps each person in at most two groups at a time.
// - Members may invite someone by their Chaukas ID. The invite only puts that
//   person on the `invited` list; nobody becomes a member until they choose
//   Stay themselves, and they can choose Leave to drop the invite.
// - Chaukas IDs (handles) are claimed once, by their owner, and can be looked
//   up one at a time but never listed.
// - Alerts can be posted by members under their own uid, start with no
//   reactions, and members may only set or clear their own reaction.
// - Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    function verdictOk(v) { return v in ['safe', 'suspicious', 'scam']; }
    function scoreOk(v) { return v is int && v >= 0 && v <= 100; }

    match /users/{uid}/checks/{checkId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && checkId.size() <= 64
        && request.resource.data.keys().hasOnly(['id', 'verdict', 'riskScore', 'category', 'summary', 'excerpt', 'source', 'createdAt', 'syncedAt'])
        && request.resource.data.keys().hasAll(['verdict', 'riskScore', 'excerpt'])
        && verdictOk(request.resource.data.verdict)
        && scoreOk(request.resource.data.riskScore)
        && str(request.resource.data.excerpt, 200)
        && (!('summary' in request.resource.data) || str(request.resource.data.summary, 400))
        && (!('category' in request.resource.data) || str(request.resource.data.category, 40))
        && (!('source' in request.resource.data) || request.resource.data.source in ['on_device', 'in_cloud', 'preview'])
        && (!('id' in request.resource.data) || request.resource.data.id == checkId);
    }

    // Chaukas ID -> uid, so family can add each other without email or phone numbers.
    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9]{2,16}-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.name, 60);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['handle'])
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z0-9]{2,16}-[0-9]{4}$');
    }

    match /circles/{circleId} {
      function me() { return request.auth.uid; }
      function isMember() { return signedIn() && me() in resource.data.members; }
      function nameFor(uid) { return str(request.resource.data.memberNames[uid], 60); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function added(f) { return request.resource.data.get(f, []).toSet().difference(resource.data.get(f, []).toSet()); }
      function removed(f) { return resource.data.get(f, []).toSet().difference(request.resource.data.get(f, []).toSet()); }
      function mapChanged(f) { return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys(); }
      // A member may show their own Chaukas ID in the group, and only one that is really theirs.
      function ownHandleOk() {
        return mapChanged('memberHandles').hasOnly([me()])
          && (!(me() in request.resource.data.get('memberHandles', {}))
            || (request.resource.data.memberHandles[me()] is string
              && request.resource.data.memberHandles[me()].matches('^[a-z0-9]{2,16}-[0-9]{4}$')
              && get(/databases/$(database)/documents/handles/$(request.resource.data.memberHandles[me()])).data.uid == me()));
      }
      // Taking your own invite off the list (on Stay or Leave) touches only your entries.
      function clearsOwnInvite() {
        return added('invited').size() == 0
          && removed('invited').hasOnly([me()])
          && !(me() in request.resource.data.get('invited', []))
          && mapChanged('invitedNames').hasOnly([me()])
          && mapChanged('invitedBy').hasOnly([me()]);
      }

      allow read: if isMember() || (signedIn() && me() in resource.data.invited);

      allow create: if signedIn()
        && circleId.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'members', 'memberNames', 'createdAt', 'invited', 'invitedNames', 'invitedBy'])
        && request.resource.data.get('invited', []) == []
        && request.resource.data.get('invitedNames', {}) == {}
        && request.resource.data.get('invitedBy', {}) == {}
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && nameFor(request.auth.uid)
        && str(request.resource.data.name, 40);

      // Join (by code, or Stay on an invite): add only yourself, and clear your own invite.
      // A member may also add their own Chaukas ID to memberHandles this way.
      // Leave: remove only yourself (and your ID). The owner may leave too; the last
      // person out deletes the group.
      // Invite: a member adds up to 5 non-members to the invited list.
      // Decline: an invited person removes only their own invite.
      allow update: if signedIn() && (
          (
            changed().hasOnly(['members', 'memberNames', 'memberHandles', 'invited', 'invitedNames', 'invitedBy'])
            && added('members').hasOnly([me()])
            && removed('members').size() == 0
            && request.resource.data.members.size() <= 50
            && mapChanged('memberNames').hasOnly([me()])
            && nameFor(me())
            && ownHandleOk()
            && (changed().hasOnly(['members', 'memberNames', 'memberHandles']) || clearsOwnInvite())
          ) || (
            changed().hasOnly(['members', 'memberNames', 'memberHandles'])
            && removed('members').hasOnly([me()])
            && added('members').size() == 0
            && mapChanged('memberNames').hasOnly([me()])
            && !(me() in request.resource.data.memberNames)
            && mapChanged('memberHandles').hasOnly([me()])
            && !(me() in request.resource.data.get('memberHandles', {}))
          ) || (
            isMember()
            && changed().hasOnly(['invited', 'invitedNames', 'invitedBy'])
            && removed('invited').size() == 0
            && added('invited').size() >= 1
            && added('invited').size() <= 5
            && !request.resource.data.invited.hasAny(resource.data.members)
            && request.resource.data.invited.size() <= 50
            && mapChanged('invitedNames').difference(added('invited')).size() == 0
            && mapChanged('invitedBy').difference(added('invited')).size() == 0
            && request.resource.data.invitedNames.size() <= 50
            && request.resource.data.invitedBy.size() <= 50
          ) || (
            me() in resource.data.get('invited', [])
            && changed().hasOnly(['invited', 'invitedNames', 'invitedBy'])
            && clearsOwnInvite()
          )
        );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /alerts/{alertId} {
        function circle() { return get(/databases/$(database)/documents/circles/$(circleId)).data; }
        function member() { return signedIn() && exists(/databases/$(database)/documents/circles/$(circleId)) && request.auth.uid in circle().members; }

        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['byUid', 'byName', 'verdict', 'riskScore', 'category', 'summary', 'excerpt', 'note', 'createdAt', 'expireAt', 'reactions'])
          && request.resource.data.byUid == request.auth.uid
          && str(request.resource.data.byName, 60)
          && verdictOk(request.resource.data.verdict)
          && scoreOk(request.resource.data.riskScore)
          && str(request.resource.data.category, 40)
          && str(request.resource.data.summary, 400)
          && str(request.resource.data.excerpt, 240)
          && str(request.resource.data.note, 280)
          && request.resource.data.createdAt == request.time
          // Warnings expire after 3 days (a TTL policy on expireAt deletes them).
          && (!('expireAt' in request.resource.data) || (request.resource.data.expireAt is timestamp
              && request.resource.data.expireAt > request.time
              && request.resource.data.expireAt <= request.time + duration.value(4, 'd')))
          && request.resource.data.reactions == {};
        allow update: if member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['seen', 'scam', 'call', 'love', 'got']);
        // The author, or the circle owner (moderation), may delete an alert.
        allow delete: if signedIn() && (resource.data.byUid == request.auth.uid || circle().ownerUid == request.auth.uid);
      }
    }
  }
}
